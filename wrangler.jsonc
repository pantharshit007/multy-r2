{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "multy-r2",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-05-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "multy-r2",
      "database_id": "e64f817b-3054-4246-98b8-9d096b269417"
    }
  ],
  "r2_buckets": [
  {
    "binding": "BUCKET_A",
    "bucket_name": "shottr-bucket"
  },
  {
    "binding": "BUCKET_B",
    "bucket_name": "mine"
  }, 
  {
    "binding": "my-super-bucket",
    "bucket_name": "great-bucket"
  }
  ],
  "secrets": {
    "required": ["AUTH_KEY_SECRET", "PRIVATE_LINK_SECRET"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "persist": true,
      "invocation_logs": true
    }
  }

}
