{
	"name": "multy-r2",
	"version": "0.1.4",
	"private": true,
	"type": "module",
	"scripts": {
		"gen:bindings": "node scripts/generateBucketNames.mjs",
		"dev": "vite",
		"wr:dev": "pnpm gen:bindings && wrangler dev",
		"build": "pnpm build:client",
		"build:client": "tsc -b && vite build",
		"build:worker": "pnpm gen:bindings",
		"build:worker-bundle": "pnpm gen:bindings && wrangler deploy --dry-run --outdir=dist-worker",
		"typecheck": "tsc -b",
		"preview": "vite preview",
		"deploy": "pnpm deploy:worker",
		"deploy:worker": "pnpm gen:bindings && wrangler deploy",
		"deploy:pages": "pnpm build:client && wrangler pages deploy dist --project-name multy-r2",
		"migrate:local": "wrangler d1 migrations apply multy-r2 --local",
		"migrate:deploy": "wrangler d1 migrations apply multy-r2 --remote",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@tanstack/react-router": "1.170.10",
		"@vitejs/plugin-react": "6.0.2",
		"clsx": "2.1.1",
		"hono": "4.12.27",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"tailwind-merge": "3.3.1",
		"vite": "8.0.14"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "4.20260530.1",
		"@tailwindcss/vite": "4.3.0",
		"@types/node": "25.9.1",
		"@types/react": "19.2.15",
		"@types/react-dom": "19.2.3",
		"tailwindcss": "4.3.0",
		"typescript": "6.0.3",
		"wrangler": "4.95.0"
	},
	"packageManager": "pnpm@10.12.4"
}
